# Names only. Never put real values in this file.
# Production database is Supabase PostgreSQL, project tupswxnfidpemjkzwgkx.
# Public project URL, not a secret:
SUPABASE_URL=https://tupswxnfidpemjkzwgkx.supabase.co
# Server-only. Direct Postgres URI from Supabase → Project Settings → Database.
DATABASE_URL=
# Server-only. Not used by the importer when DATABASE_URL is set. Never put this in the APK.
SUPABASE_SERVICE_ROLE_KEY=
# Optional distributed lock. Not a substitute for Postgres.
REDIS_URL=
# Public HTTPS API. Release Android builds refuse anything else.
PRODUCTION_API_BASE_URL=
STAGING_API_BASE_URL=
